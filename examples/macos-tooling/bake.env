# Bake config: a mobile-CI macOS image with fastlane + cocoapods on top of
# the cirruslabs Xcode image. Bake with:
#   ./bake-image.sh -d examples/macos-tooling runner.example.com

# Base image to build on. The -xcode images ship Xcode + Homebrew; use
# macos-tahoe-base for a minimal starting point.
BAKE_BASE_IMAGE=ghcr.io/cirruslabs/macos-tahoe-xcode:latest

# Local name of the baked image (no '/'). Version it: bump the suffix when
# you change the scripts, then update MACVM_IMAGE and re-provision.
BAKE_IMAGE_NAME=ghrunner-macos-tooling-v1

# Resources for the VM while baking.
BAKE_CPUS=4
BAKE_MEMORY_MB=8192
# Job disk in GB; unset keeps the base image's (140 GB for cirruslabs images).
#BAKE_DISK_SIZE_GB=180

# Guest credentials (cirruslabs images ship admin/admin).
#BAKE_SSH_USER=admin
#BAKE_SSH_PASSWORD=admin
