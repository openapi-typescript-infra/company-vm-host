# Configuration for provisioning a Mac as ephemeral GitHub Actions runners.
# Copy to runner.env, edit, then run:  ./provision.sh user@host

# GitHub organization the runners register with.
GH_ORG=your-company

# Runner group ID to register into. 1 is the org's "Default" group.
# List groups with:  gh api /orgs/$GH_ORG/actions/runner-groups
RUNNER_GROUP_ID=1

# How many runner slots of each flavor to run on this host. Setting every
# count to 0 disables the host: all slots are torn down on the next
# provision, but the installed tooling and baked images stay put.
# mac slots          run jobs natively as dedicated unprivileged users.
# linux slots        run jobs inside fresh apple/container Linux VMs (arm64).
# linuxamd64 slots   like linux, but amd64 images run under Rosetta
#                    translation - a true x64 runner (~2-5x slower).
# linuxvm slots      run jobs inside fresh arm64 apple/container machines
#                    with dockerd - use for jobs that need docker; one
#                    machine per job, deleted afterward.
# linuxvmamd64 slots docker-capable like linuxvm, but a persistent full
#                    x86_64 QEMU-emulated Lima VM (a true amd64 kernel/
#                    docker/runner; whole-system emulation, slow), scrubbed
#                    between jobs. Requires QEMU on the host (brew install
#                    qemu).
# macvm slots        run jobs inside Tart macOS VMs (max 2 - Apple's limit on
#                    concurrent macOS VMs per host).
MAC_RUNNERS=1
LINUX_RUNNERS=2
LINUX_AMD64_RUNNERS=0
LINUXVM_RUNNERS=0
LINUXVM_AMD64_RUNNERS=0
MACVM_RUNNERS=0

# Labels attached to each flavor (comma-separated). Target these from
# workflows, e.g.  runs-on: [self-hosted, linux, arm64]. The amd64 variants
# use the x64 arch label (matching GitHub's RUNNER_ARCH convention).
MAC_LABELS=self-hosted,macos,arm64
LINUX_LABELS=self-hosted,linux,arm64
LINUX_AMD64_LABELS=self-hosted,linux,x64
LINUXVM_LABELS=self-hosted,linux,arm64,docker
LINUXVM_AMD64_LABELS=self-hosted,linux,x64,docker
MACVM_LABELS=self-hosted,macos,arm64,vm

# Resources for each Linux runner VM (arm64 and, unless overridden, amd64).
LINUX_CPUS=4
LINUX_MEMORY=8G
#LINUX_AMD64_CPUS=4
#LINUX_AMD64_MEMORY=8G

# Resources and timeout for building the bundled Linux images and shipped
# flavor contexts. Heavy images (Android SDK/NDK) need more than the
# apple/container builder defaults. Timeout is seconds.
LINUX_BUILD_CPUS=4
LINUX_BUILD_MEMORY=8G
LINUX_IMAGE_BUILD_TIMEOUT=3600

# Resources for each docker-capable VM slot. Memory in GiB. arm64 (machine)
# slots get a fresh VM per job, so changes apply from the next job; disk is
# thin-provisioned by apple/container (no knob needed).
LINUXVM_CPUS=4
LINUXVM_MEMORY=8
# Disk (GiB) only applies to the persistent amd64 (QEMU) VMs.
LINUXVM_DISK=60
# amd64 (QEMU) linuxvm resources; default to the LINUXVM_* values above.
# Changing them (or RUNNER_VERSION) recreates those VMs on the next provision.
#LINUXVM_AMD64_CPUS=4
#LINUXVM_AMD64_MEMORY=8
#LINUXVM_AMD64_DISK=60
# Bump to any new value to factory-reset the persistent amd64 (QEMU) VMs on
# the next provision. arm64 linuxvm machines are already fresh per job.
LINUXVM_RESET=0

# Custom Linux image flavors: extra fleets of Linux slots running your own
# images, each with its own count/labels/resources/arch. Point a flavor at
# either
#   _BUILD_DIR - a Dockerfile directory (relative to this file); it is
#                shipped with the payload and built on the host, and may
#                build FROM the bundled base image (see examples/node20)
#   _IMAGE     - a registry reference; must be pullable anonymously, or log
#                _ghcontainer into the registry once by hand (see README)
# _ARCH is arm64 (default) or amd64; amd64 flavors build/run under Rosetta
# like the linuxamd64 slots (FROM ghrunner-linux-amd64:<version> for the
# bundled base; an _IMAGE must have a variant for the arch).
# _LABELS/_CPUS/_MEMORY default to the LINUX_* values (LINUX_AMD64_* for
# amd64 flavors, where set). _DISK optionally creates a fresh named volume of
# that size for each job and mounts it at /ghrunner-scratch; the volume is
# deleted with the job. _WARP_ORG optionally gives a compatible image a
# per-job Cloudflare WARP connection; provision with WARP_AUTH_CLIENT_ID and
# WARP_AUTH_CLIENT_SECRET, and use it only for images whose entrypoint consumes
# those values (such as android-image/).
# _ROSETTA=true is for an arm64 image that needs to run a few x86_64 Linux
# executables. It enables Apple Container's runtime Rosetta bridge, without
# making Node, Java or the Actions runner itself x86_64. It is macOS-host-only
# and cannot be combined with _ARCH=amd64.
# After a successful provision, the supervisor removes retired images whose
# names start with ghrunner-linux, retaining only images used by enabled slots.
# It never broadly prunes unrelated container images. Warn when the host falls
# below this many GiB free after that targeted cleanup (0 disables the warning).
#LINUX_IMAGE_GC=true
#LINUX_IMAGE_MIN_FREE_GB=80
#LINUX_FLAVORS="node20"
#LINUX_FLAVOR_node20_RUNNERS=1
#LINUX_FLAVOR_node20_BUILD_DIR=examples/node20
#LINUX_FLAVOR_node20_LABELS=self-hosted,linux,arm64,node-20
#LINUX_FLAVOR_node20_CPUS=4
#LINUX_FLAVOR_node20_MEMORY=8G
#LINUX_FLAVOR_node20_DISK=40G
#LINUX_FLAVOR_node20_ARCH=arm64
##LINUX_FLAVOR_node20_IMAGE=ghcr.io/acme/ci-node20-arm64:latest

# Portable your-org/your-app Android builder. This is the normal image for
# amd64 Kubernetes nodes; on Apple silicon it can also run through Rosetta.
# Start a host-local slot only after building and smoke-testing android-image/.
#LINUX_FLAVORS="android"
#LINUX_FLAVOR_android_RUNNERS=1
#LINUX_FLAVOR_android_BUILD_DIR=android-image
#LINUX_FLAVOR_android_LABELS=self-hosted,linux,x64,company-android
#LINUX_FLAVOR_android_CPUS=8
#LINUX_FLAVOR_android_MEMORY=16G
#LINUX_FLAVOR_android_DISK=80G
#LINUX_FLAVOR_android_ARCH=amd64
#LINUX_FLAVOR_android_WARP_ORG=your-company
#
# Optional Apple-silicon fallback: native arm64 Node/Java/Gradle plus Rosetta
# for the Linux x86_64 Android NDK and Hermes tools. Keep the amd64 flavor above
# as the portable Kubernetes image and use this distinct label for the hybrid.
#LINUX_FLAVORS="android androidrosetta"
#LINUX_FLAVOR_androidrosetta_RUNNERS=0
#LINUX_FLAVOR_androidrosetta_BUILD_DIR=android-image
#LINUX_FLAVOR_androidrosetta_LABELS=self-hosted,linux,arm64,company-android-rosetta
#LINUX_FLAVOR_androidrosetta_CPUS=4
#LINUX_FLAVOR_androidrosetta_MEMORY=20G
#LINUX_FLAVOR_androidrosetta_DISK=80G
#LINUX_FLAVOR_androidrosetta_ARCH=arm64
#LINUX_FLAVOR_androidrosetta_ROSETTA=true
#LINUX_FLAVOR_androidrosetta_WARP_ORG=your-company

# macOS VM slots: Tart image and guest resources. The default image is a
# clean macOS with passwordless sudo (user admin/admin, ~40GB download);
# use ghcr.io/cirruslabs/macos-tahoe-xcode:latest for Xcode jobs (~big).
MACVM_IMAGE=ghcr.io/cirruslabs/macos-tahoe-base:latest
MACVM_CPUS=4
MACVM_MEMORY_MB=8192
# Guest SSH credentials (cirruslabs images ship admin/admin).
MACVM_SSH_USER=admin
MACVM_SSH_PASSWORD=admin
# Put macOS VM guests on the host's LAN (bridged) instead of the default NAT
# network. Each VM then takes its own DHCP lease and — on a network that
# auto-registers DNS — becomes reachable by name for Screen Sharing/VNC.
# Empty (default) keeps guests on the NAT network, reachable only from this
# host. To bridge, name a host NIC: en0 is usually Ethernet, en1 Wi-Fi;
# `tart run --net-bridged=list <any-vm>` lists the candidates. Read the
# README "Reaching macOS VM slots" section first — bridging puts guests,
# with their admin/admin credentials, directly on that network.
MACVM_BRIDGE_IFACE=
# Optional stable, locally-administered unicast MAC for each bridged slot.
# Tart otherwise assigns every fresh clone a new MAC, churning DHCP leases.
# Keep these unique across every host; reserving them in DHCP gives Screen
# Sharing a dependable address and DNS record.
#MACVM_MAC_1=02:47:48:52:00:01
#MACVM_MAC_2=02:47:48:52:00:02

# ---- Warm schedules and on-demand slots -------------------------------------
# By default every slot loops forever ("always"): a runner - and for VM
# kinds, an idle VM holding its full memory reservation - waits for jobs
# around the clock. A per-kind POLICY trades job-start latency for those
# idle resources:
#   always     (default) today's behavior: the slot loops on KeepAlive.
#   scheduled  warm (always-listening) inside the warm schedule; outside it
#              the slot is down and the dispatcher boots it when a matching
#              job queues.
#   ondemand   never warm; only ever booted for a queued job.
# Off-hours pickup costs up to DISPATCH_INTERVAL of polling plus the slot's
# boot time (~2-3 min for macvm clone+boot+enroll) on the first job.
# Schedules are HOST-LOCAL time: comma-separated "Days HH:MM-HH:MM" entries
# where Days is Day or Day-Day (Mon..Sun; ranges may wrap, e.g. Fri-Mon) and
# 24:00 means midnight. A window must not cross midnight - split it:
# "Mon-Fri 22:00-24:00, Tue-Sat 00:00-02:00".
# Demand polling requires the PAT to ALSO carry repository "Actions: read"
# on the watched repos (see README "Warm schedules and on-demand slots") -
# the org "Self-hosted runners: write" alone cannot see queued jobs.
#MACVM_POLICY=scheduled
# The other kinds take a policy the same way: MAC_POLICY, LINUX_POLICY,
# LINUX_AMD64_POLICY, LINUXVM_POLICY, LINUXVM_AMD64_POLICY, and
# LINUX_FLAVOR_<name>_POLICY. (For mac slots a policy saves nothing - there
# is no VM to release - but still limits when jobs can run.)
# (Quote schedule values - this file is sourced by bash and they contain
# spaces.)
#WARM_SCHEDULE="Mon-Fri 08:00-19:00"
# Per-kind schedule override, e.g.:
#MACVM_WARM_SCHEDULE="Mon-Fri 07:00-20:00"
#
# Repos the dispatcher watches for queued jobs while a managed slot is cold
# (space-separated; a bare name means GH_ORG/name). Strongly recommended:
# when empty, every pass instead scans the org's DISPATCH_REPO_LIMIT most
# recently pushed repos, which is slower, API-hungrier, and can miss a
# rarely-pushed repo.
#DISPATCH_REPOS="mobile-apps"
#DISPATCH_INTERVAL=60          # seconds between dispatcher passes
#DISPATCH_IDLE_TIMEOUT=600     # how long a demand-booted runner waits for its job
#DISPATCH_MIN_QUEUE_AGE=30     # ignore jobs queued more recently than this
#DISPATCH_REPO_LIMIT=15        # repo-discovery cap when DISPATCH_REPOS is empty

# Version pins.
RUNNER_VERSION=2.338.2      # github.com/actions/runner releases
CONTAINER_VERSION=1.7.1     # github.com/apple/container releases (1.1.0+ for linuxvm slots)
TART_VERSION=2.41.1         # github.com/openai/tart releases
LIMA_VERSION=2.3.0          # github.com/lima-vm/lima releases (linuxvmamd64 slots only)

# Install Xcode Command Line Tools if missing (needed for git on macOS
# runners; slow on first provision). Only applies when MAC_RUNNERS > 0.
INSTALL_XCODE_CLT=true

# Expose machine-wide tooling to macOS slot jobs (see README "Toolchains on
# macOS slots"). MAC_EXTRA_PATH is prepended to the job PATH; each
# MAC_ENV_<NAME>=value becomes an env var <NAME> in jobs.
#MAC_EXTRA_PATH=/opt/homebrew/bin:/opt/homebrew/sbin:/opt/android-sdk/platform-tools
#MAC_ENV_ANDROID_HOME=/opt/android-sdk
#MAC_ENV_LANG=en_US.UTF-8
# Keep ~/Library/Caches (CocoaPods repos, gem caches, ...) between jobs on
# mac slots: much faster mobile builds, slightly weaker job-to-job hygiene.
#MAC_KEEP_CACHES=true

# The same, for macOS VM slots, naming paths inside the guest rather than on
# the host. MACVM_EXTRA_PATH is prepended to the job PATH; each
# MACVM_ENV_<NAME>=value becomes an env var <NAME> in jobs. Set a locale if
# you build iOS: without one CocoaPods aborts in unicode_normalize.
#MACVM_EXTRA_PATH=/opt/homebrew/bin:/opt/homebrew/sbin
#MACVM_ENV_LANG=en_US.UTF-8
# Keep caches across macOS VM jobs: /var/ghrunner/cache/macvm-<n> on the host
# is shared into guest n (virtiofs), and the guest's CocoaPods, yarn, npm,
# Gradle, ccache (CCACHE_DIR) and runner tool caches (RUNNER_TOOL_CACHE) are redirected
# onto it, so they survive the per-job VM teardown and image re-bakes. Jobs
# also get GHRUNNER_CACHE_DIR for anything else worth keeping. The guest
# works on a per-cycle APFS clone that is promoted only when the job ran to
# completion, so a cancelled or killed job cannot leave half-written files
# for later jobs; `mise run runner:caches rollback <n>` undoes the last
# promotion. A completed job can still poison the cache for later jobs on
# that slot, the trade-off MAC_KEEP_CACHES makes.
# Pair with MACVM_ENV_USE_CCACHE=1 for React Native / Expo iOS builds (needs
# ccache on the image; the slot also exports CCACHE_BINARY, which React
# Native's compiler wrappers require from the environment).
#MACVM_KEEP_CACHES=true

# Prefix for runner names as they appear in GitHub (default: hostname).
#RUNNER_NAME_PREFIX=runner
