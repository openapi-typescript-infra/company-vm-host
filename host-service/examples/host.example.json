{
  "version": 1,
  "stateDir": "/var/lib/company-vm-host",
  "tart": "/usr/local/bin/tart",
  "listen": { "host": "127.0.0.1", "port": 8790 },
  "capacity": { "macos": 2, "cpus": 12, "memoryMb": 32768 },
  "companies": {
    "corporation-a": {
      "tokenFile": "/etc/company-vm-host/corporation-a.token",
      "quota": { "leases": 1, "cpus": 6, "memoryMb": 16384 },
      "profiles": {
        "ios": {
          "image": "corporation-a-xcode-v1",
          "os": "macos",
          "cpus": 4,
          "memoryMb": 8192,
          "sshUser": "runner",
          "sshKeyFile": "/etc/company-vm-host/corporation-a.ssh",
          "recipes": {
            "simulators": {
              "argv": [
                "/usr/bin/xcrun",
                "simctl",
                "list",
                "devices",
                "available",
                "--json"
              ],
              "timeoutSeconds": 30
            },
            "ios-tests": {
              "argv": ["/opt/corporation-a/bin/test-ios"],
              "timeoutSeconds": 1200
            }
          }
        }
      }
    },
    "corporation-b": {
      "tokenFile": "/etc/company-vm-host/corporation-b.token",
      "quota": { "leases": 1, "cpus": 6, "memoryMb": 16384 },
      "profiles": {
        "ios": {
          "image": "corporation-b-xcode-v2",
          "os": "macos",
          "cpus": 4,
          "memoryMb": 8192,
          "sshUser": "runner",
          "sshKeyFile": "/etc/company-vm-host/corporation-b.ssh",
          "recipes": {
            "simulators": {
              "argv": [
                "/usr/bin/xcrun",
                "simctl",
                "list",
                "devices",
                "available",
                "--json"
              ],
              "timeoutSeconds": 30
            }
          }
        }
      }
    }
  }
}
