# Bake config: the mobile-CI macOS image WITHOUT the Android toolchain, for
# when Android builds move off the Mac onto a dedicated runner. Bake with:
#   ./bake-image.sh -d ios-bake -b runner.example.com
#
# This dir is deliberately thin: scripts/ is symlinks into mobile-bake/scripts,
# so both images are baked by the same code and cannot drift. The only
# difference is BAKE_WITH_ANDROID below, which those scripts read.
#
# Dropped relative to mobile-bake: android-commandlinetools, platforms
# android-36/35, build-tools, the NDK, CMake, the Gradle wrapper prefetch
# (15-prime-tools.sh self-skips), the ~/.gradle dependency warm in
# 20-prime-repo.sh, and the ANDROID_HOME/SDK_ROOT/NDK_HOME exports.
#
# KEPT, despite sounding Android-ish: Temurin 17 and the Maestro CLI. Maestro
# is a JVM tool and its e2e job drives an iOS simulator, so the JDK is not
# Android-only. Everything else (Xcode, fastlane, cocoapods, Node, gcloud,
# WARP, the pod cache warm) is identical to mobile-bake.

# Same pinned base as mobile-bake (macos-tahoe-xcode:26.5 by digest; see the
# comment there for how to move it). Keep the two in step.
BAKE_BASE_IMAGE=ghcr.io/cirruslabs/macos-tahoe-xcode@sha256:61f6e857a3d65dd2f8daf9c51c7b837fa458bcc9181ae8556e645b534dab6bf6

# The whole point of this dir. mobile-bake leaves it unset, which the scripts
# read as 1.
BAKE_WITH_ANDROID=0

# Version it the same way as mobile-bake: bump the suffix when the shared
# scripts change, then update MACVM_IMAGE and re-provision. v1 is UNBAKED and
# UNVALIDATED - this dir is staged ahead of the dedicated Android runner, so
# the first real bake should be verified (./verify-macvm.sh ... ghrunner-ios-v1)
# and put through a green iOS build before MACVM_IMAGE points at it.
BAKE_IMAGE_NAME=ghrunner-ios-v1

# Same as mobile-bake: `yarn install` across ~150 private packages plus two
# `pod install`s is the bulk of the work. The Android SDK download this bake
# skips is ~4-6GB of image and a chunk of bake time, but it is not the CPU or
# memory bound, so these do not change.
BAKE_CPUS=4
BAKE_MEMORY_MB=8192
# Same controller-side safety bound as mobile-bake: a stuck guest script or
# SSH channel fails the bake and restores paused runner slots after two hours.
BAKE_SCRIPT_TIMEOUT_MIN=120
# Same job disk as mobile-bake (see its bake.env for why 180 GB): the iOS
# Maestro suite is what outgrew the base image's 140 GB.
BAKE_DISK_SIZE_GB=180

# Guest credentials (cirruslabs images ship admin/admin).
#BAKE_SSH_USER=admin
#BAKE_SSH_PASSWORD=admin

# Deep cache warming - see mobile-bake/bake.env for the full story; it applies
# verbatim except that only the CocoaPods caches get warmed here. Both tokens
# are still mandatory: the pod warm depends on `yarn install`, which needs GCP
# Artifact Registry auth for the private @your-company packages. Access tokens
# last ~1h; mint both immediately before baking, and DO NOT COMMIT THEM:
#   BAKE_PRIME_TOKEN=$(gh auth token) \
#   BAKE_PRIME_GCP_TOKEN=$(gcloud auth print-access-token) \
#     ./bake-image.sh -d ios-bake -b runner.example.com
#
# `yarn build` (GraphQL codegen) would fail in a bake guest (no WARP enrolment,
# VPN-only endpoint), so the shared prime script skips it by default. Pod
# warming does not depend on it. Enable only when the guest has a private route.
BAKE_PRIME_WITH_CODEGEN=0
#
# Check the tail of /var/log/ghrunner-bake.log for the prime's "cache summary".
# Empty or MISSING there means the warm silently did not happen. On this image
# the summary lists only ~/.cocoapods and ~/Library/Caches/CocoaPods; ~/.gradle
# is omitted rather than reported MISSING, since it is skipped by design.
#BAKE_PRIME_TOKEN=
#BAKE_PRIME_GCP_TOKEN=
#BAKE_PRIME_REPO=your-org/your-app
#BAKE_PRIME_REF=main
